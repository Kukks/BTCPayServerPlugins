<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Plugins\BTCPayServer.Plugins.SecSwitch\BTCPayServer.Plugins.SecSwitch.csproj" />
        <!-- StaticWebAssetsEnabled=false must match the plugin's own BTCPayServer reference,
             otherwise MSBuild builds BTCPayServer twice and MSB3030 staticwebassets errors appear. -->
        <ProjectReference Include="..\submodules\btcpayserver\BTCPayServer\BTCPayServer.csproj">
            <Properties>StaticWebAssetsEnabled=false</Properties>
        </ProjectReference>
    </ItemGroup>
</Project>
