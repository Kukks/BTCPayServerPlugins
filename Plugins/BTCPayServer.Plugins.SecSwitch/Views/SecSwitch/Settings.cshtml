@model BTCPayServer.Plugins.SecSwitch.Models.SecSwitchSettings
@using System
@using System.Linq
@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Configuration
@using BTCPayServer.Plugins.SecSwitch.Models
@using BTCPayServer.Plugins.SecSwitch.Services
@using Microsoft.Extensions.Options
@inject LedgerStore Ledger
@inject System.Collections.Generic.IEnumerable<IBTCPayServerPlugin> InstalledPlugins
@inject IOptions<DataDirectories> DataDirectories
@{
    ViewData["Title"] = "SecSwitch";
    var feedUrl = Model.GetFeedUrl();
    var ledger = await Ledger.GetAsync();
    var pluginOptions = InstalledPlugins
        .Where(plugin => !plugin.SystemPlugin && BtcPayActionSink.TryResolveInstalledDirectory(
            DataDirectories.Value.PluginDir, plugin.Identifier, out _, out _))
        .Select(plugin => new { plugin.Identifier, plugin.Name })
        .Concat((Model.AutoUpdatePlugins ?? [])
            .Where(identifier => !string.IsNullOrWhiteSpace(identifier))
            .Select(identifier => new { Identifier = identifier, Name = $"{identifier} (unavailable)" }))
        .DistinctBy(plugin => plugin.Identifier, StringComparer.OrdinalIgnoreCase)
        .OrderBy(plugin => plugin.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();
}

<div class="sticky-header">
    <h2>SecSwitch</h2>
</div>
<partial name="_StatusMessage" />

@if (Model.Enabled && (!ViewData.ModelState.TryGetValue(nameof(Model.FeedUrl), out var feedField) || feedField.Errors.Count == 0))
{
    if (feedUrl is null)
    {
        <div class="alert alert-warning" role="alert">
            The official BTCPay advisory feed is pending publication. Set a trusted feed URL to start checking for advisories.
        </div>
    }
    else if (AdvisoryFeed.IsSupportedFeedUrl(feedUrl))
    {
        if (ledger.LastPollAt is not { } lastPollAt || !string.Equals(ledger.LastPollFeedUrl, feedUrl, StringComparison.Ordinal))
        {
            <div class="alert alert-info" role="alert">SecSwitch has not polled this advisory feed yet.</div>
        }
        else if (ledger.LastPollError is not null)
        {
            <div class="alert alert-danger" role="alert">
                The last poll of this advisory feed failed (@lastPollAt.ToString("u")): @ledger.LastPollError.
                This server is not being checked against advisories until a poll succeeds.
            </div>
        }
        else
        {
            <p class="text-muted">Last successful poll: @lastPollAt.ToString("u")</p>
        }
    }
}

<form method="post">
    <div class="form-check mb-3">
        <input asp-for="Enabled" type="checkbox" class="form-check-input" />
        <label asp-for="Enabled" class="form-check-label">Check advisories and notify server admins</label>
    </div>
    <div class="form-group mb-3">
        <label asp-for="FeedUrl" class="form-label">Advisory feed URL</label>
        <input asp-for="FeedUrl" class="form-control" placeholder="@SecSwitchSettings.ProposedFeedUrl" />
        <div class="form-text">
            Use a direct <code>https://</code> URL. Choose a publisher you trust to issue advisories that can trigger the kill switch.
        </div>
        <span asp-validation-for="FeedUrl" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="AutoApply" type="checkbox" class="form-check-input" />
        <label asp-for="AutoApply" class="form-check-label">Apply the advisory kill switch</label>
        <div class="form-text">SecSwitch can queue a restart to disable an affected plugin.</div>
    </div>
    <div class="alert alert-warning d-flex align-items-start gap-2 mb-4">
        <vc:icon symbol="warning" css-class="mt-1 flex-shrink-0" />
        <div>
            <div class="fw-semibold">BTCPay Server lockdown</div>
            <div>
                With the kill switch on, an affected BTCPay Server enters recovery mode. Admins can sign in,
                review advisories, suppress an advisory after confirming, or update BTCPay Server.
                Ordinary requests return HTTP 503 and the lock survives a restart.
            </div>
        </div>
    </div>
    <fieldset class="mb-4">
        <legend class="h6">Automatic updates</legend>
        <p class="form-text">
            Automatic updates require advisory checks to be enabled and a successful poll of the configured feed.
            Choose which components SecSwitch may update. Updates can restart BTCPay Server.
        </p>
        <div class="form-check">
            <input asp-for="AutoUpdateCore" type="checkbox" class="form-check-input" />
            <label asp-for="AutoUpdateCore" class="form-check-label">BTCPay Server (requires host update support)</label>
        </div>
        @for (var index = 0; index < pluginOptions.Length; index++)
        {
            var plugin = pluginOptions[index];
            var inputId = $"sec-switch-auto-update-{index}";
            <div class="form-check">
                <input name="@nameof(Model.AutoUpdatePlugins)" value="@plugin.Identifier"
                       id="@inputId" type="checkbox" class="form-check-input"
                       checked="@Model.IsPluginAutoUpdateEnabled(plugin.Identifier)" />
                <label for="@inputId" class="form-check-label">@plugin.Name</label>
            </div>
        }
    </fieldset>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Audit" class="btn btn-secondary">Audit log</a>
</form>
