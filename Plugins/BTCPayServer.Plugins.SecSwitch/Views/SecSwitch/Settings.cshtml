@model BTCPayServer.Plugins.SecSwitch.Models.SecSwitchSettings
@inject BTCPayServer.Plugins.SecSwitch.Services.LedgerStore Ledger
@{
    ViewData["Title"] = "SecSwitch";
    var ledger = await Ledger.GetAsync();
}

<div class="sticky-header">
    <h2>SecSwitch</h2>
</div>
<partial name="_StatusMessage" />

<div class="alert alert-warning" role="alert">
    SecSwitch trusts the advisory feed completely: whoever controls the feed can make this server disable plugins,
    update itself or go into lockdown. Review these settings carefully before enabling.
</div>

@if (Model.Enabled)
{
    if (ledger.LastPollAt is null)
    {
        <div class="alert alert-info" role="alert">SecSwitch has not polled the advisory feed yet.</div>
    }
    else if (ledger.LastPollError is not null)
    {
        <div class="alert alert-danger" role="alert">
            The last poll of the advisory feed failed (@ledger.LastPollAt.Value.ToString("u")): @ledger.LastPollError.
            This server is not being checked against advisories until a poll succeeds.
        </div>
    }
    else
    {
        <p class="text-muted">Last successful poll: @ledger.LastPollAt.Value.ToString("u")</p>
    }
}

<form method="post">
    <div class="form-check mb-3">
        <input asp-for="Enabled" type="checkbox" class="form-check-input" />
        <label asp-for="Enabled" class="form-check-label">Enable SecSwitch</label>
    </div>
    <div class="form-group mb-3">
        <label asp-for="FeedUrl" class="form-label">Advisory feed URL</label>
        <input asp-for="FeedUrl" class="form-control" />
        <div class="form-text">Must be an absolute <code>https://</code> URL. Redirects are not followed.</div>
        <span asp-validation-for="FeedUrl" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="AutoApply" type="checkbox" class="form-check-input" />
        <label asp-for="AutoApply" class="form-check-label">
            Apply actions automatically (unchecked = notify only)
        </label>
    </div>
    <div class="form-check mb-3">
        <input asp-for="PreferUpdateOverDisable" type="checkbox" class="form-check-input" />
        <label asp-for="PreferUpdateOverDisable" class="form-check-label">
            Update to the fixed version when an advisory names one, instead of disabling the plugin
        </label>
    </div>
    <div class="form-check mb-4">
        <input asp-for="AutoUpdateAll" type="checkbox" class="form-check-input" />
        <label asp-for="AutoUpdateAll" class="form-check-label">
            Also update plugins, and BTCPay Server itself through the host integration, to any newer release (requires automatic actions)
        </label>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Audit" class="btn btn-secondary">Audit log</a>
</form>
