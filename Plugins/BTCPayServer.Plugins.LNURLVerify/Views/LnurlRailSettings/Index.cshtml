@using BTCPayServer.Abstractions.Models
@using BTCPayServer.Plugins.LNURLVerify
@model BTCPayServer.Plugins.LNURLVerify.LnurlRailSettings
@{
    ViewData.SetLayoutModel(new LayoutModel(LnurlRailSettingsController.ActivePage, "LNURL rails"));
    var store = Context.GetStoreData();
    var lnurl = LnurlRailProvisioning.LnurlValue(store);
    var version = typeof(LNURLVerifyPlugin).Assembly.GetName().Version;
}
<form method="post">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="mb-0">@ViewData["Title"]</h3>
        <button type="submit" class="btn btn-primary" id="Save">Save</button>
    </div>
    <partial name="_StatusMessage" />
    <p>Rails your LNURL advertises join Lightning in one "Bitcoin" checkout tab, and each token asset gets a tab of its own.</p>
    @if (lnurl is null)
    {
        <p class="text-muted" id="LnurlRailsNone">
            This store's Lightning is not an LNURL.
            <a asp-controller="UIStores" asp-action="SetupLightningNode" asp-route-storeId="@store.Id" asp-route-cryptoCode="BTC">Set up a Lightning address</a>.
        </p>
    }
    else
    {
        <div id="LnurlRailsCard" class="mb-4" aria-live="polite"><span class="spinner-border spinner-border-sm" role="status"></span></div>
    }
    <div class="form-check form-switch">
        <input asp-for="ActivateAllRailsOnOpen" type="checkbox" class="form-check-input" />
        <label asp-for="ActivateAllRailsOnOpen" class="form-check-label">Request every rail when the checkout opens</label>
    </div>
    <p class="form-text">
        When off, a Bitcoin rail is requested from your LNURL only when the payer taps it. A token network is always requested only
        on a tap, since its quote can be a real order with a third party.
    </p>
</form>
@if (lnurl is not null)
{
    <link href="@Url.Content("~/Resources/lnurlverify/setup-card.css")?v=@version" rel="stylesheet" />
    <script src="@Url.Content("~/Resources/lnurlverify/setup-card.js")?v=@version"></script>
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const out = document.getElementById('LnurlRailsCard');
            const token = out.closest('form').elements['__RequestVerificationToken'].value;
            let summary;
            try {
                const body = new URLSearchParams({ lnurl: @Safe.Json(lnurl), __RequestVerificationToken: token });
                summary = await (await fetch(@Safe.Json(Url.Action("Resolve", "LnurlRailSettings", new { storeId = store.Id })), { method: 'POST', body })).json();
            } catch (e) {
                summary = { error: 'The lookup failed: ' + e.message };
            }
            LnurlSetupCard.render(out, summary, { iconUrl: @Safe.Json(Url.Content("~/Resources/lnurlverify/icons/") + "{0}.svg?v=" + version) });
        });
    </script>
}
