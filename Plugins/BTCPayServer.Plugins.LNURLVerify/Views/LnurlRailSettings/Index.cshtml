@using BTCPayServer.Abstractions.Models
@using BTCPayServer.Data
@using BTCPayServer.Plugins.LNURLVerify
@model BTCPayServer.Plugins.LNURLVerify.LnurlRailSettings
@{
    ViewData.SetLayoutModel(new LayoutModel(LnurlRailSettingsController.ActivePage, "LNURL rails"));
    var store = Context.GetStoreData();
    var blob = store.GetStoreBlob();
    var rails = LnurlRails.All.Where(r => store.GetPaymentMethodConfig(r.PaymentMethodId) is not null).ToList();
}
<form method="post">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="mb-0">@ViewData["Title"]</h3>
        <button type="submit" class="btn btn-primary" id="Save">Save</button>
    </div>
    <partial name="_StatusMessage" />
    <p>
        Rails your LNURL advertises join Lightning in one "Bitcoin" checkout tab.
        @(rails.Any() ? "" : "Your LNURL advertises no extra rails right now.")
    </p>
    @foreach (var rail in rails)
    {
        <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" name="enabledRails" value="@rail.PaymentMethodId" id="Rail-@rail.PaymentMethodId" checked="@(!blob.IsExcluded(rail.PaymentMethodId))" />
            <label class="form-check-label" for="Rail-@rail.PaymentMethodId">@rail.Label</label>
            <input type="hidden" name="shownRails" value="@rail.PaymentMethodId" />
        </div>
    }
    <div class="form-check form-switch">
        <input asp-for="ActivateAllRailsOnOpen" type="checkbox" class="form-check-input" />
        <label asp-for="ActivateAllRailsOnOpen" class="form-check-label">Request every rail when the checkout opens</label>
    </div>
    <p class="form-text">When off, a rail is requested from your LNURL only when the payer taps it.</p>
</form>
