@using BTCPayServer.Client
@using BTCPayServer.Data
@using BTCPayServer.Plugins.LNURLVerify
@{
    var store = Context.GetStoreDataOrNull();
}
@if (store is not null && LnurlRails.All.Any(r => store.GetPaymentMethodConfig(r.PaymentMethodId) is not null))
{
    <li class="nav-item">
        <a permission="@Policies.CanModifyStoreSettings" asp-controller="LnurlRailSettings" asp-action="Index" asp-route-storeId="@store.Id"
           class="nav-link @ViewData.IsActivePage(LnurlRailSettingsController.ActivePage)" id="Nav-LnurlRails">
            <span>LNURL rails</span>
        </a>
    </li>
}
