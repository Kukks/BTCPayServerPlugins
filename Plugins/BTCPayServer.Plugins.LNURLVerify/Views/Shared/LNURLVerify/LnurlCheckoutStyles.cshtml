<style>
    /* A choice inside the selected tab: a recessed track, so it never reads as another row of core's tab pills. */
    .lnurl-options {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--btcpay-space-xs);
        margin: 0 0 var(--btcpay-space-m);
        padding: var(--btcpay-space-xs);
        border-radius: var(--btcpay-border-radius-l);
        background: var(--btcpay-body-bg);
    }
    .lnurl-options button {
        flex: 1 1 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .375rem;
        padding: .375rem .75rem;
        border: 1px solid transparent;
        border-radius: var(--btcpay-border-radius);
        background: transparent;
        color: var(--btcpay-body-text-muted);
        font-size: var(--btcpay-font-size-s);
        font-weight: var(--btcpay-font-weight-semibold);
        white-space: nowrap;
        transition: color .15s ease, background-color .15s ease, border-color .15s ease;
    }
    .lnurl-options button:hover:not(:disabled) {
        color: var(--btcpay-body-text);
    }
    .lnurl-options button.active {
        color: var(--btcpay-body-text);
        background: var(--btcpay-bg-tile);
        border-color: var(--btcpay-primary);
    }
    .lnurl-options img,
    .lnurl-options .icon {
        width: 1.125rem;
        height: 1.125rem;
        flex-shrink: 0;
    }
    .lnurl-networks {
        display: block;
    }
    .lnurl-options-tiles {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--btcpay-space-xs);
    }
    .lnurl-options-tiles > button {
        flex: 0 0 calc((100% - 2 * var(--btcpay-space-xs)) / 3);
        flex-direction: column;
        gap: .25rem;
        padding: .5rem .25rem;
        font-size: var(--btcpay-font-size-xs);
        white-space: normal;
    }
    .lnurl-options-tiles img {
        width: 1.5rem;
        height: 1.5rem;
    }
    .lnurl-options .lnurl-network-chosen {
        display: flex;
        width: 100%;
        flex-direction: row;
        justify-content: flex-start;
        gap: var(--btcpay-space-s);
        padding: .5rem .75rem;
        color: var(--btcpay-body-text);
        font-size: var(--btcpay-font-size-s);
    }
    .lnurl-network-chosen > img {
        width: 1.25rem;
        height: 1.25rem;
    }
    .lnurl-network-change {
        margin-inline-start: auto;
        color: var(--btcpay-body-link);
        font-size: var(--btcpay-font-size-xs);
    }
    .lnurl-options .lnurl-network-keep {
        position: absolute;
        inset-inline-end: .5rem;
        top: var(--btcpay-space-xs);
        padding: 0;
        border: 0;
        color: var(--btcpay-body-link);
        font-size: var(--btcpay-font-size-xs);
    }
    .lnurl-options-caption {
        position: relative;
        flex: 0 0 100%;
        padding-top: var(--btcpay-space-xs);
        color: var(--btcpay-body-text-muted);
        font-size: var(--btcpay-font-size-xs);
        text-align: center;
    }
    .lnurl-options-modes {
        flex-wrap: nowrap;
    }
    .lnurl-options-modes > button {
        padding-inline: .5rem;
        font-size: var(--btcpay-font-size-xs);
    }
    .lnurl-options-modes img {
        width: 1rem;
        height: 1rem;
    }
    .lnurl-qr-icon {
        position: absolute;
        box-sizing: content-box;
        width: var(--icon-size);
        height: var(--icon-size);
        padding: var(--icon-border-size);
        border-radius: 50%;
        background: var(--icon-border-color);
    }
    .lnurl-qr-icon > img {
        width: 100%;
        height: 100%;
    }
    .lnurl-qr-icon > .lnurl-qr-badge {
        position: absolute;
        right: -.25rem;
        bottom: -.25rem;
        width: 45%;
        height: 45%;
        padding: 2px;
        border-radius: 50%;
        background: var(--icon-border-color);
    }
    .lnurl-provider {
        display: flex;
        align-items: center;
        gap: var(--btcpay-space-xs);
        margin: var(--btcpay-space-m) auto 0;
        padding: 0;
        border: 0;
        background: none;
        color: var(--btcpay-body-text-muted);
        font-size: var(--btcpay-font-size-s);
    }
    .lnurl-provider:hover {
        color: var(--btcpay-body-text);
    }
    .lnurl-provider .icon {
        width: 1rem;
        height: 1rem;
        color: var(--btcpay-info);
    }
    .lnurl-terms {
        width: min(24rem, calc(100% - 2rem));
        padding: 0;
        border: 0;
        border-radius: var(--btcpay-border-radius-l);
        background: var(--btcpay-bg-tile);
        color: var(--btcpay-body-text);
    }
    .lnurl-terms > div {
        padding: var(--btcpay-space-l);
    }
    .lnurl-terms::backdrop {
        background: rgba(0, 0, 0, .5);
    }
    .lnurl-terms ul {
        text-align: start;
        padding-inline-start: 1.25rem;
        margin-bottom: var(--btcpay-space-l);
    }
    .lnurl-terms li + li {
        margin-top: var(--btcpay-space-s);
    }
    .lnurl-wc-glyph {
        width: 1.5rem;
        height: 1.5rem;
        margin: -.25rem .25rem -.25rem 0;
    }
    /* The network list and the chosen network swap by height, so the QR below slides rather than jumps. */
    .lnurl-collapse {
        display: grid;
        grid-template-rows: 1fr;
        transition: grid-template-rows .25s ease, opacity .25s ease;
    }
    .lnurl-collapse > div {
        min-height: 0;
        overflow: hidden;
    }
    .lnurl-collapse.shut {
        grid-template-rows: 0fr;
        opacity: 0;
    }
    .lnurl-collapse.shut > div {
        visibility: hidden;
        transition: visibility 0s .25s;
    }
    .lnurl-fade-enter-active,
    .lnurl-fade-leave-active {
        transition: opacity .15s ease;
    }
    .lnurl-fade-enter,
    .lnurl-fade-leave-to {
        opacity: 0;
    }
    @@media (prefers-reduced-motion: reduce) {
        .lnurl-collapse,
        .lnurl-collapse.shut > div,
        .lnurl-options button,
        .lnurl-fade-enter-active,
        .lnurl-fade-leave-active {
            transition: none;
        }
    }
</style>
