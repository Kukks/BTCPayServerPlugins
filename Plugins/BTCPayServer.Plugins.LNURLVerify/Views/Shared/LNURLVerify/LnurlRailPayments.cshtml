@using BTCPayServer.Plugins.LNURLVerify
@using BTCPayServer.Services
@using BTCPayServer.Services.Invoices
@model BTCPayServer.Models.InvoicingModels.InvoiceDetailsModel
@inject DisplayFormatter DisplayFormatter
@inject PaymentMethodHandlerDictionary Handlers
@{
    var payments = Model.Payments
        .Where(p => Handlers.TryGetValue(p.PaymentMethodId, out var h) && h is LnurlRailPaymentHandler)
        .Select(p => (Payment: p, Rail: LnurlRails.For(p.PaymentMethodId)!,
            Data: ((LnurlRailPaymentHandler)Handlers[p.PaymentMethodId]).ParsePaymentDetails(p.Details)))
        .ToList();
}
@if (payments.Any())
{
    <section>
        <h5>LNURL rail payments</h5>
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Rail</th>
                <th>Destination</th>
                <th>Reference</th>
                <th>Received</th>
                <th class="text-end">Amount</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var (payment, rail, data) in payments)
            {
                <tr>
                    <td>@rail.Label</td>
                    <td><vc:truncate-center text="@data.Destination" classes="truncate-center-id" /></td>
                    <td><vc:truncate-center text="@data.PaymentReference" classes="truncate-center-id" /></td>
                    <td>@payment.ReceivedTime.ToBrowserDate()</td>
                    <td class="payment-value text-end text-nowrap">
                        <span data-sensitive class="text-success">@DisplayFormatter.Currency(payment.Value, payment.Currency)</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}
