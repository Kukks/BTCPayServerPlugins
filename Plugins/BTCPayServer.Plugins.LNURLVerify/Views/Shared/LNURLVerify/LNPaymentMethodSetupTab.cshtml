@using BTCPayServer.Models.StoreViewModels
@using BTCPayServer.Plugins.LNURLVerify
@model BTCPayServer.Models.StoreViewModels.LightningNodeViewModel
@{
    if (Model.CryptoCode != "BTC")
    {
        return;
    }
    var current = Model.LightningNodeType == LightningNodeType.Custom ? LnurlRailProvisioning.LnurlValue(Model.ConnectionString) : null;
    var storeId = Context.GetStoreData().Id;
}

<div id="LNURLVerifySetup" class="pt-3 tab-pane fade" role="tabpanel" aria-labelledby="LightningNodeType-LNURLVerify">
    <div class="form-group">
        <label for="LNURLVerifyAddress" class="form-label">Lightning address or LNURL <span id="LNURLVerifyStatus" class="text-muted ms-1"></span></label>
        <input id="LNURLVerifyAddress" class="form-control" value="@current" placeholder="you@example.com" autocomplete="off" spellcheck="false" />
        <div class="form-text">
            No node or API key: a Lightning address or LNURL-pay receives, and an LNURL-withdraw with a <code>payLink</code> also sends.
        </div>
        <span asp-validation-for="ConnectionString" class="text-danger"></span>
    </div>
    <div id="LNURLVerifySummary" aria-live="polite"></div>
</div>

<style>
    .lnurl-setup {
        padding: var(--btcpay-space-s) var(--btcpay-space-m);
    }
    .lnurl-setup-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--btcpay-space-s);
        padding-bottom: var(--btcpay-space-s);
    }
    .lnurl-setup-row {
        display: flex;
        align-items: center;
        gap: var(--btcpay-space-s);
        min-height: 2.5rem;
        border-top: 1px solid var(--btcpay-body-border-light);
    }
    .lnurl-setup-row .form-check {
        min-height: 0;
        margin: 0;
    }
    .lnurl-setup-row .form-check-input {
        margin-top: 0;
    }
    .lnurl-setup-row img {
        width: 1.25rem;
        height: 1.25rem;
    }
    .lnurl-setup-end {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: .375rem;
        margin-inline-start: auto;
        color: var(--btcpay-body-text-muted);
        font-size: var(--btcpay-font-size-s);
        text-align: end;
    }
    .lnurl-setup-end .off {
        opacity: .3;
        filter: grayscale(1);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tab = document.getElementById('LightningNodeType-LNURLVerify');
        const input = document.getElementById('LNURLVerifyAddress');
        const out = document.getElementById('LNURLVerifySummary');
        const status = document.getElementById('LNURLVerifyStatus');
        const form = input.form;
        const resolveUrl = @Safe.Json(Url.Action("Resolve", "LnurlRailSettings", new { storeId }));
        const railsUrl = @Safe.Json(Url.Action("Index", "LnurlRailSettings", new { storeId }));
        const enabledUrl = @Safe.Json(Url.Action("Enabled", "LnurlRailSettings", new { storeId }));
        const iconUrl = @Safe.Json(Url.Content("~/Resources/lnurlverify/icons/"));
        let resolving = null, timer = null, dirty = false, canonical = null, resubmitting = false;
        const el = (tag, className, text) => {
            const e = document.createElement(tag);
            if (className) e.className = className;
            if (text != null) e.textContent = text;
            return e;
        };
        const sats = msat => msat == null ? '?' : (msat / 1000).toLocaleString();
        const range = o => sats(o.minSendable) + ' – ' + sats(o.maxSendable) + ' sats';
        const icon = (name, alt) => {
            const i = el('img');
            i.src = iconUrl + name + '.svg';
            i.alt = alt;
            return i;
        };

        async function resolve () {
            clearTimeout(timer);
            const value = input.value.trim();
            if (value === resolving) return;
            resolving = value;
            status.textContent = value ? 'looking up…' : '';
            if (!value) {
                out.replaceChildren();
                return;
            }
            // The card changes only once the answer arrives: on a blur from pressing Save, a change now would move Save from under the click.
            let summary;
            try {
                const body = new URLSearchParams({ lnurl: value, __RequestVerificationToken: form.elements['__RequestVerificationToken'].value });
                summary = await (await fetch(resolveUrl, { method: 'POST', body })).json();
            } catch (e) {
                summary = { error: 'The lookup failed: ' + e.message };
            }
            if (value !== resolving) return;
            // The input moved on and its own lookup is waiting out the debounce; forgetting this one lets a return to it look up again.
            if (value !== input.value.trim()) {
                resolving = null;
                return;
            }
            status.textContent = '';
            if (summary.error) resolving = null;
            canonical = summary.connectionString ? { value: value, string: summary.connectionString } : null;
            render(summary);
        }

        // One switch per rail or token asset; a token's networks are its icons, dimmed where checkout cannot offer them.
        function row (lead, options, ...label) {
            const r = el('div', 'lnurl-setup-row');
            const locked = options.every(o => o.locked) ? lead.locked : null;
            const sw = el('input', 'form-check-input');
            sw.type = 'checkbox';
            sw.setAttribute('role', 'switch');
            sw.setAttribute('aria-label', label.map(l => l.textContent || l.alt).join(' '));
            sw.checked = !locked && !lead.excluded;
            sw.disabled = !lead.toggle || !!locked;
            if (lead.toggle && !locked) {
                sw.dataset.toggle = lead.toggle;
                sw.addEventListener('change', () => { dirty = true; });
            }
            const end = el('span', 'lnurl-setup-end');
            if (lead.unit && lead.toggle && !locked) {
                for (const o of options) {
                    const why = o.locked || o.transient;
                    const net = o.icon ? icon(o.icon, o.label) : el('span', null, o.label);
                    net.title = o.label + (why ? ': ' + why : '');
                    net.dataset.option = o.id;
                    if (o.locked) net.classList.add('off');
                    end.append(net);
                }
            } else {
                end.textContent = locked || (lead.excluded ? '' : lead.transient) || '';
            }
            const toggle = el('div', 'form-check form-switch');
            toggle.append(sw);
            r.append(toggle, ...label, end);
            return r;
        }

        function render (s) {
            out.replaceChildren();
            dirty = false;
            if (s.error) {
                out.append(el('p', 'text-danger mb-0', s.error));
                return;
            }
            const card = el('div', 'lnurl-setup border rounded');
            const head = el('div', 'lnurl-setup-head');
            head.append(el('strong', null, s.domain), el('span', 'text-muted', (s.sends ? 'Sends and receives' : 'Receives only') + ' · ' + range(s)));
            card.append(head);
            const units = new Map();
            for (const o of s.options) {
                if (o.unit && o.toggle) units.set(o.unit, [...(units.get(o.unit) || []), o]);
                else card.append(Object.assign(row(o, [o], el('span', null, o.label)), { id: 'LNURLVerifyOption-' + (o.id || 'lightning') }));
            }
            for (const [unit, options] of units) {
                const name = el('span', null, unit);
                const r = options[0].unitIcon ? row(options[0], options, icon(options[0].unitIcon, ''), name) : row(options[0], options, name);
                card.append(Object.assign(r, { id: 'LNURLVerifyUnit-' + unit }));
            }
            out.append(card);
            const note = el('p', 'form-text mb-0', 'Verify support is checked when you save, with one small invoice. More options on the ');
            const link = el('a', null, 'LNURL rails');
            link.href = railsUrl;
            note.append(link, ' page.');
            out.append(note);
        }

        input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(resolve, 600); });
        input.addEventListener('blur', resolve);
        // Enter would otherwise submit through the form's first button, the hidden Custom pane's "Test connection".
        input.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); resolve(); } });
        tab.addEventListener('shown.bs.tab', resolve);
        // Capture phase: the switches save before the page's form does, never alongside it, since both write the store.
        form.addEventListener('submit', async e => {
            if (!tab.checked || !dirty) return;
            e.preventDefault();
            e.stopImmediatePropagation();
            dirty = false;
            const body = new URLSearchParams({ __RequestVerificationToken: form.elements['__RequestVerificationToken'].value });
            for (const sw of out.querySelectorAll('input[data-toggle]')) {
                body.append('shownRails', sw.dataset.toggle);
                if (sw.checked) body.append('enabledRails', sw.dataset.toggle);
            }
            let saved = false;
            try { saved = (await fetch(enabledUrl, { method: 'POST', body })).ok; } catch (err) { }
            if (!saved) {
                dirty = true;
                status.textContent = 'the switches could not be saved, try again';
                return;
            }
            form.requestSubmit(e.submitter);
        }, true);
        // Only the lookup knows the canonical string, whose server is the value's origin — the key core's
        // non-admin safety check reads. Without one yet, look up first and re-submit through the same button.
        form.addEventListener('submit', e => {
            if (!tab.checked) return;
            const value = input.value.trim();
            if (canonical && canonical.value === value) {
                form.elements['ConnectionString'].value = canonical.string;
                return;
            }
            // Nothing entered has no origin to look up; post it so the server names the missing value.
            if (!value) {
                form.elements['ConnectionString'].value = 'type=lnurl;value=';
                return;
            }
            e.preventDefault();
            if (resubmitting) return;
            resubmitting = true;
            resolving = null;
            const submitter = e.submitter;
            resolve().then(() => {
                resubmitting = false;
                if (canonical && canonical.value === input.value.trim()) form.requestSubmit(submitter);
            });
        });
        if (@Safe.Json(current is not null)) tab.click();
    });
</script>
